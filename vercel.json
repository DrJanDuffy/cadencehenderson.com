{
  "buildCommand": "npm run cloudflare:images:sync && npm run build",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cadencehenderson.com" }],
      "destination": "https://www.cadencehenderson.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "cadencehenderson.com" }],
      "destination": "https://www.cadencehenderson.com/:path*",
      "permanent": true
    }
  ]
}
